{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "year": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "category": {
      "default": "guidelines",
      "type": "string"
    },
    "specialty": {
      "type": "string"
    },
    "status": {
      "default": "published",
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keyRecommendations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceClass": {
      "type": "string"
    },
    "sections": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}