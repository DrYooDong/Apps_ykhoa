{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cliniportal.local/schemas/arrhythmia-classification.schema.json",
  "title": "CliniPortal Arrhythmia Classification Database",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "axes",
    "entities"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "axes": {
      "type": "object",
      "required": [
        "rate",
        "qrsWidth",
        "regularity",
        "mechanism",
        "origin",
        "structuralHeart"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "tags",
          "ecgCriteria",
          "rarity"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          },
          "ecgCriteria": {
            "type": "string",
            "minLength": 1
          },
          "rarity": {
            "enum": [
              "common",
              "uncommon",
              "rare",
              "very-rare"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ecgFeatures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "differentials": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "redFlags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "year"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "year": {
                  "type": "integer",
                  "minimum": 1900,
                  "maximum": 2100
                },
                "url": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "draft",
                  "reviewed",
                  "verified"
                ]
              },
              "lastReviewed": {
                "type": "string",
                "format": "date"
              },
              "reviewer": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}