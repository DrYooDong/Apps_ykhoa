---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { HANDBOOK_SPECIALTIES } from '../../content/clinical-handbook/data/handbook-catalog';

const handbookMdxModules = import.meta.glob('/src/content/clinical-handbook/**/*.mdx', { eager: true });
const totalArticlesCount = Object.keys(handbookMdxModules).length;
const totalDiseasesCount = HANDBOOK_SPECIALTIES.reduce((acc, s) => acc + s.diseases.length, 0);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout 
  title="Sổ Tay Kinh Nghiệm & Đúc Kết Lâm Sàng — CliniPortal" 
  description="Hệ thống đúc kết kinh nghiệm lâm sàng thực chiến theo từng Chuyên khoa & Bệnh lý cụ thể."
>
  <div class="handbook-hub-container">
    
    <!-- BREADCRUMB -->
    <nav class="handbook-breadcrumb" aria-label="Breadcrumb">
      <a href={`${baseUrl}/`}>🏠 Trang chủ</a>
      <span class="separator">/</span>
      <span class="current">Sổ Tay Kinh Nghiệm & Đúc Kết Lâm Sàng</span>
    </nav>

    <!-- HERO SECTION -->
    <header class="handbook-hero">
      <div class="handbook-hero-badge">
        <span class="handbook-pulse-dot"></span>
        <span>Clinical Pearls & Decision Handbook • EBM 2026</span>
      </div>
      <h1>🩺 Sổ Tay Kinh Nghiệm & Đúc Kết Lâm Sàng</h1>
      <p>
        Kho tích lũy tri thức thực chiến theo từng <strong>Chuyên khoa & Bệnh lý cụ thể</strong>.
        Tập trung vào vùng xám ra quyết định, cạm bẫy cận lâm sàng, sai lầm kê đơn thường gặp và bảng đối chiếu nhanh tại giường bệnh.
      </p>

      <div class="handbook-kpi-row">
        <div class="handbook-kpi-pill">
          <i class="fa-solid fa-layer-group"></i>
          <div>
            <strong>{HANDBOOK_SPECIALTIES.length}</strong>
            <span>Chuyên Khoa</span>
          </div>
        </div>
        <div class="handbook-kpi-pill">
          <i class="fa-solid fa-viruses"></i>
          <div>
            <strong>{totalDiseasesCount}</strong>
            <span>Bệnh Lý Trọng Tâm</span>
          </div>
        </div>
        <div class="handbook-kpi-pill">
          <i class="fa-solid fa-book-medical"></i>
          <div>
            <strong>{totalArticlesCount > 0 ? totalArticlesCount : 'MDX Native'}</strong>
            <span>Bài Đúc Kết</span>
          </div>
        </div>
      </div>
    </header>

    <!-- SEARCH BAR -->
    <div class="handbook-search-bar">
      <i class="fa-solid fa-magnifying-glass search-icon"></i>
      <input 
        type="text" 
        id="astro-handbook-search" 
        class="handbook-search-input"
        placeholder="Tìm kiếm bệnh lý hoặc kinh nghiệm (Viêm gan B, Sốt xuất huyết, ALT, FibroScan...)" 
        aria-label="Tìm kiếm bệnh lý trong sổ tay"
      />
      <div class="handbook-search-counter" id="astro-search-counter">
        <span>Hiển thị tất cả <strong>{HANDBOOK_SPECIALTIES[0].diseases.length}</strong> bệnh lý</span>
      </div>
    </div>

    <!-- TẦNG 1: MỤC LỤC 8 CHUYÊN KHOA -->
    <section class="handbook-specialty-section">
      <div class="handbook-section-title-row">
        <h2>
          <i class="fa-solid fa-layer-group"></i>
          <span>1. Chuyên Khoa Y Khoa</span>
        </h2>
        <button type="button" class="btn-toggle-specialties" id="astro-btn-toggle-overview">
          <i class="fa-solid fa-table-cells-large"></i>
          <span>Tổng quan 8 Chuyên khoa</span>
        </button>
      </div>

      <!-- SPECIALTY RAIL -->
      <div class="handbook-specialty-rail">
        {HANDBOOK_SPECIALTIES.map((spec, idx) => (
          <div 
            class={`handbook-specialty-pill ${idx === 0 ? 'is-active' : ''}`}
            data-spec-id={spec.id}
          >
            <i class={`fa-solid ${spec.icon}`} style={idx === 0 ? '' : `color: ${spec.color};`}></i>
            <span>{spec.shortName}</span>
            <span class="pill-count">
              {spec.diseases.length > 0 ? `${spec.diseases.length} bệnh` : 'Sắp có'}
            </span>
          </div>
        ))}
      </div>

      <!-- COLLAPSIBLE OVERVIEW GRID -->
      <div class="handbook-specialties-overview-grid" id="astro-overview-grid" style="display: none;">
        {HANDBOOK_SPECIALTIES.map((spec, idx) => (
          <div class={`spec-overview-card ${idx === 0 ? 'is-active' : ''}`}>
            <div class="spec-overview-icon" style={`background: ${spec.bgColor}; color: ${spec.color};`}>
              <i class={`fa-solid ${spec.icon}`}></i>
            </div>
            <div>
              <h4>{spec.name}</h4>
              <p>{spec.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- TẦNG 2: DANH MỤC BỆNH LÝ TRUYỀN NHIỄM -->
    <section class="handbook-disease-section">
      <div class="handbook-section-title-row">
        <div>
          <div style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--handbook-primary); font-weight: 700; margin-bottom: 0.2rem;">
            Chuyên khoa trọng tâm
          </div>
          <h2>
            <i class="fa-solid fa-virus-covid" style="color: #0284c7;"></i>
            <span>1. Chuyên Khoa Truyền Nhiễm & Nhiệt Đới</span>
          </h2>
        </div>
        <span class="handbook-status-badge">
          {HANDBOOK_SPECIALTIES[0].badge}
        </span>
      </div>

      <div class="handbook-diseases-grid" id="astro-diseases-container">
        {HANDBOOK_SPECIALTIES[0].diseases.map(disease => (
          <div 
            class="handbook-disease-card"
            data-name={disease.name.toLowerCase()}
            data-icd={disease.icd10.toLowerCase()}
            data-summary={disease.summary.toLowerCase()}
          >
            <div>
              <div class="disease-card-header">
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                  <div class="disease-card-icon" style={`color: ${disease.color || 'var(--handbook-primary)'};`}>
                    <i class={`fa-solid ${disease.icon}`}></i>
                  </div>
                  <span class="handbook-icd-badge">
                    ICD-10: {disease.icd10}
                  </span>
                </div>
                {disease.badge && (
                  <span class="handbook-status-badge">
                    {disease.badge}
                  </span>
                )}
              </div>

              <h3>{disease.name}</h3>
              <div class="disease-name-en">{disease.nameEn}</div>
              <p class="disease-card-desc">{disease.summary}</p>

              <div class="handbook-pearl-preview-box">
                <div class="pearl-box-title">
                  <i class="fa-solid fa-lightbulb"></i>
                  <span>Đúc kết cốt lõi:</span>
                </div>
                <ul>
                  {disease.keyPearlsPreview.slice(0, 2).map(p => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="disease-card-footer">
              <span class="article-count-label">
                <i class="fa-solid fa-book-medical"></i>
                {disease.articles.length > 0 ? (
                  <span><strong>{disease.articles.length}</strong> bài đúc kết</span>
                ) : (
                  <span>Đang biên soạn</span>
                )}
              </span>

              {disease.articles.length > 0 ? (
                <a 
                  href={`${baseUrl}/clinical-handbook/${disease.specialtyId}/${disease.slug}/${disease.articles[0].slug}`} 
                  class="btn-handbook-read"
                >
                  <span>Xem đúc kết</span>
                  <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
                </a>
              ) : (
                <a 
                  href={`${baseUrl}/index.html#/clinical-handbook/${disease.specialtyId}/${disease.slug}`} 
                  class="btn-handbook-read"
                >
                  <span>Xem chi tiết</span>
                  <i class="fa-solid fa-chevron-right" style="font-size: 0.75rem;"></i>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  // 1. Live Search Filter in Astro
  const searchInput = document.getElementById('astro-handbook-search') as HTMLInputElement | null;
  const searchCounter = document.getElementById('astro-search-counter');
  const cards = document.querySelectorAll('.handbook-disease-card');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visible = 0;

      cards.forEach(card => {
        const el = card as HTMLElement;
        const name = el.getAttribute('data-name') || '';
        const icd = el.getAttribute('data-icd') || '';
        const summary = el.getAttribute('data-summary') || '';
        const text = el.innerText.toLowerCase();

        const match = !val || name.includes(val) || icd.includes(val) || summary.includes(val) || text.includes(val);
        if (match) {
          el.style.display = 'flex';
          visible++;
        } else {
          el.style.display = 'none';
        }
      });

      if (searchCounter) {
        if (val) {
          searchCounter.innerHTML = `Tìm thấy <strong>${visible}</strong> kết quả phù hợp cho "<em>${val}</em>"`;
        } else {
          searchCounter.innerHTML = `Hiển thị tất cả <strong>${cards.length}</strong> bệnh lý`;
        }
      }
    });
  }

  // 2. Toggle Overview Grid
  const btnToggle = document.getElementById('astro-btn-toggle-overview');
  const overviewGrid = document.getElementById('astro-overview-grid');

  if (btnToggle && overviewGrid) {
    btnToggle.addEventListener('click', () => {
      const isHidden = overviewGrid.style.display === 'none';
      overviewGrid.style.display = isHidden ? 'grid' : 'none';
      btnToggle.innerHTML = isHidden 
        ? '<i class="fa-solid fa-chevron-up"></i><span>Thu gọn 8 Chuyên khoa</span>'
        : '<i class="fa-solid fa-table-cells-large"></i><span>Tổng quan 8 Chuyên khoa</span>';
    });
  }
</script>
