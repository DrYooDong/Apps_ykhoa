---
import ArticleLayout from '../../../components/layout/ArticleLayout.astro';
import Alert from '../../../components/ui/Alert.astro';
import QuickNav from '../../../components/ui/QuickNav.astro';
import FlowchartViewer from '../../../components/flowchart/FlowchartViewer.astro';

export async function getStaticPaths() {
  const mdxModules = import.meta.glob('/src/content/ebm/research/kho-nghien-cuu/*.mdx', { eager: true });

  return Object.entries(mdxModules).map(([path, mod]: [string, any]) => {
    const slug = mod.frontmatter?.slug || path.split('/').pop()?.replace(/\.mdx$/, '') || 'index';
    return {
      params: { slug },
      props: {
        entry: mod
      }
    };
  });
}

const { entry } = Astro.props;
const { Content, frontmatter } = entry;
---

<ArticleLayout
  title={frontmatter.title}
  description={frontmatter.description || frontmatter.summary}
  systemName={`CliniResearch Studio • ${frontmatter.journal || frontmatter.organization || 'Medical Research'} (${frontmatter.year || '2026'})`}
  code={frontmatter.trialAcronym || frontmatter.code || String(frontmatter.design || 'STUDY').toUpperCase()}
  clinicalPearls={frontmatter.clinicalPearls || frontmatter.keyRecommendations || []}
  sections={frontmatter.sections || []}
>
  <Content components={{
    Alert,
    QuickNav,
    FlowchartViewer
  }} />
</ArticleLayout>
