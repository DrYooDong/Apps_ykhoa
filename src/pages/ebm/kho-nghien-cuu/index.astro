---
import BaseLayout from '../../../components/layout/BaseLayout.astro';

const researchModules = import.meta.glob('/src/content/ebm/research/kho-nghien-cuu/*.mdx', { eager: true });
const studies = Object.entries(researchModules)
  .map(([path, mod]: [string, any]) => ({
    slug: mod.frontmatter?.slug || path.split('/').pop()?.replace(/\.mdx$/, '') || 'index',
    trialAcronym: mod.frontmatter?.trialAcronym || '',
    title: mod.frontmatter?.title || 'Phân tích nghiên cứu y khoa',
    description: mod.frontmatter?.description || mod.frontmatter?.summary || '',
    journal: mod.frontmatter?.journal || mod.frontmatter?.organization || 'Medical Journal',
    year: mod.frontmatter?.year || '2026',
    design: mod.frontmatter?.design || 'rct',
    outcomeDirection: mod.frontmatter?.outcomeDirection || 'positive-superior',
    sampleSize: mod.frontmatter?.sampleSize || null
  }))
  .sort((a, b) => Number(b.year) - Number(a.year));
---

<BaseLayout
  title="Kho Phân Tích Nghiên Cứu Y Khoa Chuyên Sâu (CliniResearch Studio) — CliniPortal"
  description="Kho lưu trữ và đối sánh đa chiều các bài phân tích chuyên sâu thử nghiệm lâm sàng RCT, Meta-Analysis và Đoàn hệ."
>
  <div class="res-astro-hub">
    <header class="res-astro-hero">
      <div class="res-astro-eyebrow">
        <span class="res-pill"><i class="fa-solid fa-microscope"></i> CliniResearch Studio</span>
        <span class="res-pill">{studies.length} Nghiên Cứu Phân Tích Chuyên Sâu</span>
      </div>
      <h1>Kho Phân Tích Nghiên Cứu &amp; Thẩm Định Phản Biện Y Khoa</h1>
      <p>
        Hệ thống giải phẫu độc lập các thử nghiệm lâm sàng ngẫu nhiên (RCT), phân tích gộp (Meta-Analysis) và nghiên cứu đoàn hệ theo khung PICO, Cochrane RoB 2.0, GRADE và 7 trục nhãn đối sánh chung.
      </p>
      <div class="res-astro-hero-actions">
        <a href="/#/ebm/research?mode=compare" class="res-cta-btn">
          <i class="fa-solid fa-scale-balanced"></i> Mở Bàn Cân Đối Sánh Đa Chiều (SPA Studio)
        </a>
      </div>
    </header>

    <div class="res-astro-grid">
      {studies.map((st) => (
        <a href={`/ebm/kho-nghien-cuu/${st.slug}`} class="res-astro-card">
          <div>
            <div class="res-card-top">
              <span class="res-badge-design">{String(st.design).toUpperCase()}</span>
              <span class="res-badge-journal">{st.journal} • {st.year}</span>
            </div>
            <h3>
              {st.trialAcronym && <span class="res-acronym">[{st.trialAcronym}] </span>}
              {st.title}
            </h3>
            {st.description && <p>{st.description}</p>}
          </div>
          <div class="res-card-btm">
            <span class="res-meta-n">{st.sampleSize ? `N = ${Number(st.sampleSize).toLocaleString('en-US')}` : 'Synthesis'}</span>
            <span class="res-read-link">Giải phẫu chi tiết <i class="fa-solid fa-arrow-right"></i></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .res-astro-hub {
    max-width: var(--shell-max-w, 1380px);
    margin: 0 auto;
    padding: clamp(1rem, 2.5vw, 2rem) var(--shell-gutter, 1rem);
  }
  .res-astro-hero {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 2.5vw, 2rem);
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-xs);
  }
  .res-astro-eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }
  .res-pill {
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
  }
  .res-astro-hero h1 {
    font-size: var(--text-2xl);
    margin: 0 0 0.5rem;
  }
  .res-astro-hero p {
    color: var(--color-text-muted);
    max-width: 820px;
    margin: 0 0 1rem;
  }
  .res-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-surface);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .res-astro-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: 1rem;
  }
  .res-astro-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    color: var(--color-text);
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .res-astro-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }
  .res-card-top {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .res-badge-design {
    color: var(--color-primary);
  }
  .res-badge-journal {
    color: var(--color-text-muted);
  }
  .res-astro-card h3 {
    font-size: var(--text-md);
    line-height: 1.35;
    margin: 0 0 0.45rem;
  }
  .res-acronym {
    color: var(--color-primary);
  }
  .res-astro-card p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .res-card-btm {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.65rem;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .res-meta-n {
    color: var(--color-text-muted);
  }
  .res-read-link {
    color: var(--color-primary);
  }
</style>
