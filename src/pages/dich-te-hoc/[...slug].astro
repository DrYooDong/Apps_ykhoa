---
import ArticleLayout from '../../components/layout/ArticleLayout.astro';
import Alert from '../../components/ui/Alert.astro';
import QuickNav from '../../components/ui/QuickNav.astro';

export async function getStaticPaths() {
  const mdxModules = import.meta.glob('/src/content/basic-medical/epidemiology/**/*.mdx', { eager: true });
  
  return Object.entries(mdxModules).map(([path, mod]: [string, any]) => {
    const slug = mod.frontmatter?.slug || path.split('/').pop()?.replace(/\.mdx$/, '') || 'index';
    return {
      params: { slug },
      props: {
        entry: mod
      }
    };
  });
}

const { entry } = Astro.props;
const { Content, frontmatter } = entry;
---

<ArticleLayout
  title={frontmatter.title}
  description={frontmatter.description}
  systemName="Dịch Tễ Học Y Khoa"
  code={frontmatter.code}
  clinicalPearls={frontmatter.clinicalPearls}
  sections={frontmatter.pillars}
>
  <Content components={{
    EpiAlert: Alert,
    EpiPillarsNav: QuickNav,
    Alert,
    QuickNav
  }} />
</ArticleLayout>
