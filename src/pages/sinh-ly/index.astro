---
import BaseLayout from '../../components/layout/BaseLayout.astro';

const physioModules = import.meta.glob('/src/content/basic-medical/physiology/**/*.mdx', { eager: true });
const articles = Object.entries(physioModules).map(([path, mod]: [string, any]) => ({
  slug: mod.frontmatter?.slug || path.split('/').pop()?.replace(/\.mdx$/, '') || 'index',
  title: mod.frontmatter?.title || 'Bài giảng Sinh lý học',
  description: mod.frontmatter?.description || '',
  systemName: mod.frontmatter?.systemName || 'Sinh Lý Hệ Thống',
  code: mod.frontmatter?.code || ''
}));
---

<BaseLayout title="Giải Phẫu & Sinh Lý Học Lâm Sàng — CliniPortal" description="Hệ thống bài giảng Sinh lý học Y khoa và ứng dụng lâm sàng EBM chuẩn Guyton & Hall">
  <div class="hub-container">
    <header class="hub-header">
      <span class="badge badge-primary"><i class="fas fa-heart-pulse"></i> Cơ Sở Y Khoa</span>
      <h1>Giải Phẫu & Sinh Lý Học Lâm Sàng</h1>
      <p>Tổng hợp 40 bài giảng sinh lý học cơ quan (Tế bào & Điện thế màng, Thần kinh & Cơ, Tim mạch & Hô hấp, Tiêu hóa & Chuyển hóa, Thận - Tiết niệu, Nội tiết & Sinh sản, Nhi khoa) chuẩn hóa theo giáo trình Guyton & Ganong tích hợp ca lâm sàng EBM.</p>
    </header>

    <div class="articles-grid">
      {articles.map((art) => (
        <a href={`/sinh-ly/${art.slug}`} class="article-card">
          <div class="card-meta">
            <span class="badge badge-primary">{art.systemName}</span>
            {art.code && <span class="badge">{art.code}</span>}
          </div>
          <h3>{art.title}</h3>
          {art.description && <p>{art.description}</p>}
          <span class="card-link-text">Đọc bài giảng <i class="fas fa-arrow-right"></i></span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .hub-container {
    max-width: var(--content-wide-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }
  .hub-header {
    background: var(--gradient-card-glow);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-8);
    margin-bottom: var(--space-10);
  }
  .hub-header h1 {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .hub-header p {
    color: var(--color-text-muted);
    max-width: 780px;
    margin: 0;
    line-height: 1.6;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }
  .article-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }
  .article-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }
  .card-meta {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }
  .article-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
    color: var(--color-text);
    line-height: 1.4;
  }
  .article-card p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.5;
  }
  .card-link-text {
    color: var(--color-primary);
    font-weight: var(--font-medium);
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>
