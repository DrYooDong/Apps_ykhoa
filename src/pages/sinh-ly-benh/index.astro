---
import BaseLayout from '../../components/layout/BaseLayout.astro';

const pathoModules = import.meta.glob('/src/content/basic-medical/pathophysiology-cases/*.mdx', { eager: true });
const cases = Object.entries(pathoModules).map(([path, mod]: [string, any]) => ({
  slug: mod.frontmatter?.slug || path.split('/').pop()?.replace(/\.mdx$/, '') || 'index',
  title: mod.frontmatter?.title || 'Ca lâm sàng sinh lý bệnh',
  description: mod.frontmatter?.description || '',
  specialty: mod.frontmatter?.specialty || 'Nội Khoa',
  code: mod.frontmatter?.code || ''
}));
---

<BaseLayout title="Cơ Chế Bệnh Sinh & Sinh Lý Bệnh Lâm Sàng (CCBS) — CliniPortal" description="58 Ca lâm sàng phân tích cơ chế bệnh sinh chi tiết">
  <div class="hub-container">
    <header class="hub-header">
      <span class="badge badge-warning"><i class="fas fa-heart-pulse"></i> Sinh Lý Bệnh (CCBS)</span>
      <h1>Cơ Chế Bệnh Sinh & Ca Lâm Sàng Phân Tích</h1>
      <p>Tổng hợp 58 ca bệnh nội khoa điển hình (ACS, Tim mạch, Hô hấp, Tiêu hóa, Thận học, Nội tiết, Huyết học) với chuỗi logic bệnh sinh từ phân tử đến triệu chứng.</p>
    </header>

    <div class="articles-grid">
      {cases.map((cs) => (
        <a href={`/sinh-ly-benh/${cs.slug}`} class="article-card">
          <div class="card-meta">
            <span class="badge badge-warning">{cs.specialty}</span>
            {cs.code && <span class="badge">{cs.code}</span>}
          </div>
          <h3>{cs.title}</h3>
          {cs.description && <p>{cs.description}</p>}
          <span class="card-link-text">Phân tích ca bệnh <i class="fas fa-arrow-right"></i></span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .hub-container {
    max-width: var(--content-wide-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }
  .hub-header {
    background: var(--gradient-card-glow);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-8);
    margin-bottom: var(--space-10);
  }
  .hub-header h1 {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .hub-header p {
    color: var(--color-text-muted);
    max-width: 780px;
    margin: 0;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }
  .article-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    color: var(--color-text);
    transition: transform var(--tr), box-shadow var(--tr), border-color var(--tr);
  }
  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--clinical-warning);
  }
  .card-meta {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .article-card h3 {
    font-size: var(--text-md);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }
  .article-card p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-link-text {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--clinical-warning);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
</style>
