---
import BaseLayout from '../../components/layout/BaseLayout.astro';

const biochemModules = import.meta.glob('/src/content/basic-medical/biochemistry/**/*.mdx', { eager: true });
const articles = Object.entries(biochemModules).map(([path, mod]: [string, any]) => ({
  slug: mod.frontmatter?.slug || path.split('/').pop()?.replace(/\.mdx$/, '') || 'index',
  title: mod.frontmatter?.title || 'Bài giảng Hóa sinh',
  description: mod.frontmatter?.description || '',
  blockName: mod.frontmatter?.blockName || 'Chuyển Hóa',
  code: mod.frontmatter?.code || ''
}));
---

<BaseLayout title="Hóa Sinh Y Học & Sinh Học Phân Tử — CliniPortal" description="Hệ thống bài giảng Hóa sinh y học và Chuyển hóa năng lượng tế bào">
  <div class="hub-container">
    <header class="hub-header">
      <span class="badge badge-pearl"><i class="fas fa-atom"></i> Cơ Sở Y Khoa</span>
      <h1>Hóa Sinh Y Học & Sinh Học Phân Tử</h1>
      <p>Tổng hợp các khối kiến thức hóa sinh tế bào, enzym học, chuyển hóa Glucid/Lipid/Protid, di truyền phân tử và dấu ấn xét nghiệm lâm sàng.</p>
    </header>

    <div class="articles-grid">
      {articles.map((art) => (
        <a href={`/hoa-sinh/${art.slug}`} class="article-card">
          <div class="card-meta">
            <span class="badge badge-primary">{art.blockName}</span>
            {art.code && <span class="badge">{art.code}</span>}
          </div>
          <h3>{art.title}</h3>
          {art.description && <p>{art.description}</p>}
          <span class="card-link-text">Đọc bài giảng <i class="fas fa-arrow-right"></i></span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .hub-container {
    max-width: var(--content-wide-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }
  .hub-header {
    background: var(--gradient-card-glow);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-8);
    margin-bottom: var(--space-10);
  }
  .hub-header h1 {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .hub-header p {
    color: var(--color-text-muted);
    max-width: 740px;
    margin: 0;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }
  .article-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    color: var(--color-text);
    transition: transform var(--tr), box-shadow var(--tr), border-color var(--tr);
  }
  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-primary);
  }
  .card-meta {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .article-card h3 {
    font-size: var(--text-md);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }
  .article-card p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-link-text {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
</style>
