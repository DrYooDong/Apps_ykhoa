---
import BaseLayout from '../components/layout/BaseLayout.astro';

// Đếm số lượng bài viết sinh lý & dịch tễ học tự động
const physioModules = import.meta.glob('/src/content/basic-medical/physiology/**/*.mdx');
const epiModules = import.meta.glob('/src/content/basic-medical/epidemiology/**/*.mdx');

const physioCount = Object.keys(physioModules).length;
const epiCount = Object.keys(epiModules).length;
---

<BaseLayout 
  title="CliniPortal — Hệ Sinh Thái Y Khoa Lâm Sàng & Y Học Chứng Cứ"
  description="Hệ sinh thái công cụ hỗ trợ lâm sàng, hướng dẫn điều trị y học chứng cứ và bài giảng y khoa chất lượng cao."
>
  <div class="homepage-container">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-content">
        <div class="hero-pill">
          <span class="pulse-dot"></span>
          <span>CliniPortal v2.0 — Next-Gen Medical Ecosystem</span>
        </div>

        <h1 class="hero-heading">
          Kiến Thức Y Khoa Chuẩn Xác.<br />
          <span class="gradient-text">Hỗ Trợ Quyết Định Lâm Sàng.</span>
        </h1>

        <p class="hero-subtext">
          Hệ sinh thái y khoa offline-first tích hợp bài giảng Sinh lý học Guyton/Ganong, Dịch tễ học bệnh lý, Khuyến cáo điều trị Y học chứng cứ và Bộ máy tính lâm sàng.
        </p>

        <div class="hero-actions">
          <a href="/sinh-ly/sl-tb-daicuong-tb" class="btn-primary">
            <i class="fas fa-book-open"></i>
            <span>Khám Phá Sinh Lý Học</span>
          </a>
          <a href="/dich-te-hoc/dth-dengue" class="btn-secondary">
            <i class="fas fa-virus"></i>
            <span>Kho Dịch Tễ Học</span>
          </a>
        </div>
      </div>

      <div class="hero-stats-banner">
        <div class="stat-card">
          <span class="stat-number">{physioCount > 0 ? physioCount : '50+'}</span>
          <span class="stat-label">Bài Giảng Sinh Lý MDX</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-card">
          <span class="stat-number">{epiCount > 0 ? epiCount : '12+'}</span>
          <span class="stat-label">Bệnh Lý Dịch Tễ Học</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-card">
          <span class="stat-number">100%</span>
          <span class="stat-label">Offline-First & PWA</span>
        </div>
      </div>
    </section>

    <!-- Bento Grid Section -->
    <section class="bento-section">
      <div class="section-title-wrap">
        <span class="badge badge-pearl">Hệ Sinh Thái Phân Hệ</span>
        <h2>Các Phân Hệ Y Khoa Chuyên Biệt</h2>
      </div>

      <div class="bento-grid">
        <!-- Bento Card 1: Physiology -->
        <a href="/sinh-ly/sl-tb-daicuong-tb" class="bento-card card-span-2 bento-physio">
          <div class="bento-icon">
            <i class="fas fa-dna"></i>
          </div>
          <div class="bento-content">
            <div class="bento-tags">
              <span class="badge badge-primary">Cơ Sở Y Khoa</span>
              <span class="badge">Guyton 14th & Ganong 26th</span>
            </div>
            <h3>Sinh Lý Học & Nội Môi</h3>
            <p>Hệ thống bài giảng sinh lý học y khoa phân tầng theo 9 khối cơ quan, tích hợp sơ đồ phản hồi âm tính và điểm nhấn lâm sàng.</p>
          </div>
          <div class="bento-arrow">
            <i class="fas fa-arrow-right"></i>
          </div>
        </a>

        <!-- Bento Card 2: Epidemiology -->
        <a href="/dich-te-hoc/dth-dengue" class="bento-card bento-epi">
          <div class="bento-icon">
            <i class="fas fa-virus"></i>
          </div>
          <div class="bento-content">
            <div class="bento-tags">
              <span class="badge badge-pearl">Dịch Tễ Học</span>
            </div>
            <h3>Dịch Tễ Học & Y Tế Công Cộng</h3>
            <p>Tam giác dịch tễ học, chu kỳ truyền bệnh véc-tơ, sốt xuất huyết, sốt rét, viêm màng não và bệnh mạn tính.</p>
          </div>
          <div class="bento-arrow">
            <i class="fas fa-arrow-right"></i>
          </div>
        </a>

        <!-- Bento Card 3: EBM Guidelines -->
        <a href="/ebm/kho-guidelines" class="bento-card bento-ebm">
          <div class="bento-icon">
            <i class="fas fa-book-medical"></i>
          </div>
          <div class="bento-content">
            <div class="bento-tags">
              <span class="badge badge-warning">Khuyến Cáo EBM</span>
            </div>
            <h3>Y Học Chứng Cứ & Phác Đồ</h3>
            <p>Tóm tắt khuyến cáo quốc tế (KDIGO, ESC, ACC/AHA, GOLD, GINA) phân tầng Class I/II/III và Level of Evidence.</p>
          </div>
          <div class="bento-arrow">
            <i class="fas fa-arrow-right"></i>
          </div>
        </a>

        <!-- Bento Card 4: Clinical Tools -->
        <a href="/cong-cu" class="bento-card card-span-2 bento-tools">
          <div class="bento-icon">
            <i class="fas fa-calculator"></i>
          </div>
          <div class="bento-content">
            <div class="bento-tags">
              <span class="badge badge-primary">CDSS Engine</span>
              <span class="badge">Offline Calculators</span>
            </div>
            <h3>Bộ Máy Tính & Thang Điểm Lâm Sàng</h3>
            <p>Phân tích Khí Máu Động Mạch (ABG Studio), eGFR CKD-EPI, Chỉnh liều Insulin, Sepsis SOFA và Thang điểm nguy cơ tim mạch.</p>
          </div>
          <div class="bento-arrow">
            <i class="fas fa-arrow-right"></i>
          </div>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .homepage-container {
    max-width: var(--content-wide-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  /* --- Hero Styling --- */
  .hero-section {
    background: var(--gradient-card-glow);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-8) var(--space-8);
    margin-bottom: var(--space-16);
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--clinical-normal);
    box-shadow: 0 0 8px var(--clinical-normal);
  }

  .hero-heading {
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .gradient-text {
    background: var(--gradient-hero);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtext {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: white;
    font-weight: 700;
    font-size: var(--text-sm);
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
    transition: transform var(--tr-fast), background-color var(--tr-fast);
  }

  .btn-primary:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-2px);
    color: white;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-weight: 700;
    font-size: var(--text-sm);
    box-shadow: var(--shadow-sm);
    transition: transform var(--tr-fast), background-color var(--tr-fast);
  }

  .btn-secondary:hover {
    background-color: var(--color-surface-offset);
    transform: translateY(-2px);
  }

  .hero-stats-banner {
    display: flex;
    align-items: center;
    justify-content: space-around;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: var(--space-1);
  }

  .stat-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .stat-divider {
    width: 1px;
    height: 36px;
    background-color: var(--color-divider);
  }

  /* --- Bento Grid Styling --- */
  .section-title-wrap {
    margin-bottom: var(--space-8);
  }

  .section-title-wrap h2 {
    font-size: var(--text-2xl);
    margin-top: var(--space-2);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .card-span-2 {
    grid-column: span 2;
  }

  .bento-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    box-shadow: var(--shadow-sm);
    transition: transform var(--tr), box-shadow var(--tr), border-color var(--tr);
    color: var(--color-text);
  }

  .bento-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-primary);
  }

  .bento-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    background-color: var(--color-primary-hl);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }

  .bento-tags {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .bento-content h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .bento-content p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .bento-arrow {
    align-self: flex-end;
    color: var(--color-primary);
    font-size: var(--text-md);
    margin-top: var(--space-4);
    transition: transform var(--tr-fast);
  }

  .bento-card:hover .bento-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 860px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    .card-span-2 {
      grid-column: span 1;
    }
    .hero-stats-banner {
      flex-direction: column;
      gap: var(--space-4);
    }
    .stat-divider {
      display: none;
    }
  }
</style>
