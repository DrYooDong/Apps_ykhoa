---
export interface EpiTriangleNode {
  title: string;
  subtitle?: string;
  items?: string[];
  color?: string;
}

export interface Props {
  agent?: EpiTriangleNode;
  host?: EpiTriangleNode;
  environment?: EpiTriangleNode;
  vectorOrBridge?: string;
  centerTitle?: string;
}

const {
  agent = { title: 'Tác Nhân gây bệnh', items: [] },
  host = { title: 'Vật Chủ cảm nhiễm', items: [] },
  environment = { title: 'Môi Trường thuận lợi', items: [] },
  vectorOrBridge = 'VÉC-TƠ TRUNG GIAN',
  centerTitle = 'TIÊU ĐIỂM DỊCH'
} = Astro.props;

const agentColor = agent.color || 'var(--clinical-critical)';
const hostColor = host.color || 'var(--color-primary)';
const envColor = environment.color || 'var(--clinical-normal)';
---

<div class="epi-triangle-container">
  <div class="triangle-badge-wrap">
    <span class="badge badge-pearl">
      <i class="fas fa-draw-polygon"></i> MÔ HÌNH TAM GIÁC DỊCH TỄ HỌC TƯƠNG TÁC
    </span>
  </div>

  <div class="triangle-nodes-grid">
    <!-- Agent Node -->
    <div class="node-box agent-box">
      <div class="node-icon agent-icon">
        <i class="fas fa-virus"></i>
      </div>
      <h4>{agent.title}</h4>
      {agent.subtitle && <small class="node-subtitle">{agent.subtitle}</small>}
      {agent.items && agent.items.length > 0 && (
        <ul class="node-items">
          {agent.items.map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>
      )}
    </div>

    <!-- Host Node -->
    <div class="node-box host-box">
      <div class="node-icon host-icon">
        <i class="fas fa-user-shield"></i>
      </div>
      <h4>{host.title}</h4>
      {host.subtitle && <small class="node-subtitle">{host.subtitle}</small>}
      {host.items && host.items.length > 0 && (
        <ul class="node-items">
          {host.items.map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>
      )}
    </div>

    <!-- Environment Node -->
    <div class="node-box env-box">
      <div class="node-icon env-icon">
        <i class="fas fa-tree-city"></i>
      </div>
      <h4>{environment.title}</h4>
      {environment.subtitle && <small class="node-subtitle">{environment.subtitle}</small>}
      {environment.items && environment.items.length > 0 && (
        <ul class="node-items">
          {environment.items.map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <div class="triangle-center-banner">
    <span class="center-bridge">{vectorOrBridge}</span>
    <span class="center-focus">{centerTitle}</span>
  </div>
</div>

<style>
  .epi-triangle-container {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    margin: var(--space-8) 0;
    box-shadow: var(--shadow-sm);
  }

  .triangle-badge-wrap {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .triangle-nodes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .node-box {
    background-color: var(--color-surface-offset);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .agent-box { border-top: 4px solid var(--clinical-critical); }
  .host-box { border-top: 4px solid var(--color-primary); }
  .env-box { border-top: 4px solid var(--clinical-normal); }

  .node-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: var(--text-md);
    margin-bottom: var(--space-3);
  }

  .agent-icon { background: var(--clinical-critical); }
  .host-icon { background: var(--color-primary); }
  .env-icon { background: var(--clinical-normal); }

  .node-box h4 {
    font-size: var(--text-md);
    margin-bottom: var(--space-1);
  }

  .node-subtitle {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .node-items {
    font-size: var(--text-xs);
    color: var(--color-text);
    padding-left: var(--space-4);
    margin: 0;
  }

  .node-items li {
    margin-bottom: var(--space-1);
  }

  .triangle-center-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-primary-hl);
    border: 1px solid rgba(var(--color-primary-rgb), 0.2);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .center-bridge { color: var(--color-primary); }
  .center-focus { color: var(--clinical-critical); }

  @media (max-width: 768px) {
    .triangle-nodes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
