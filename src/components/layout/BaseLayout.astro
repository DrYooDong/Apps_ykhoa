---
import Header from '../shared/Header.astro';
import Footer from '../shared/Footer.astro';
import '../../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'CliniPortal — Hệ sinh thái Y khoa Lâm sàng',
  description = 'Hệ sinh thái công cụ hỗ trợ lâm sàng, hướng dẫn điều trị y học chứng cứ và bài giảng y khoa chất lượng cao.',
  ogImage = '/assets/icons/app-icon.svg'
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#0284c7">

  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>

  <!-- Typography, Icons & KaTeX Math -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">

  <link rel="icon" type="image/svg+xml" href="/assets/icons/app-icon.svg">
</head>
<body>
  <div class="app-layout">
    <Header currentPath={currentPath} />
    <main class="app-main">
      <slot />
    </main>
    <Footer />
  </div>
</body>
</html>

<style>
  .app-layout {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .app-main {
    flex: 1;
  }
</style>
