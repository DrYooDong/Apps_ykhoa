---
import BaseLayout from './BaseLayout.astro';
import Alert from '../ui/Alert.astro';

export interface SectionMeta {
  id: string;
  number?: number;
  title: string;
  icon?: string;
}

export interface Props {
  title: string;
  description?: string;
  systemName?: string;
  code?: string;
  guytonChapter?: string;
  clinicalPearls?: string[];
  sections?: SectionMeta[];
}

const {
  title,
  description,
  systemName = 'Sinh Lý Học Y Khoa',
  code,
  guytonChapter,
  clinicalPearls = [],
  sections = []
} = Astro.props;
---

<BaseLayout title={`${title} — CliniPortal`} description={description}>
  <div class="article-container">
    <!-- Hero Header -->
    <header class="article-hero">
      <div class="hero-badges">
        <span class="badge badge-pearl">
          <i class="fas fa-layer-group"></i>
          {systemName}
        </span>
        {code && (
          <span class="badge badge-primary">
            <i class="fas fa-hashtag"></i>
            {code}
          </span>
        )}
      </div>

      <h1 class="hero-title">{title}</h1>

      {description && <p class="hero-description">{description}</p>}

      {guytonChapter && (
        <div class="hero-ref">
          <i class="fas fa-book-bookmark"></i>
          <span>{guytonChapter}</span>
        </div>
      )}
    </header>

    <!-- Clinical Pearls (if any) -->
    {clinicalPearls.length > 0 && (
      <div class="pearls-banner">
        <Alert type="pearl" title="Điểm Nhấn Lâm Sàng & Trọng Tâm (Clinical Pearls)">
          <ul>
            {clinicalPearls.map((pearl) => (
              <li>{pearl}</li>
            ))}
          </ul>
        </Alert>
      </div>
    )}

    <!-- Article Body with Sidebar TOC -->
    <div class="article-layout-grid">
      <div class="article-content-wrapper">
        <article class="article-prose">
          <slot />
        </article>
      </div>

      {sections.length > 0 && (
        <aside class="article-sidebar" aria-label="Mục lục bài viết">
          <div class="toc-sticky-box">
            <div class="toc-title">
              <i class="fas fa-list-ul"></i>
              <span>Mục Lục Bài Đọc</span>
            </div>
            <ul class="toc-list">
              {sections.map((sec, idx) => (
                <li>
                  <a href={`#${sec.id}`} class="toc-link">
                    <span class="toc-idx">{sec.number ?? idx + 1}</span>
                    <span class="toc-text">{sec.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .article-container {
    max-width: var(--content-wide-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4);
  }

  .article-hero {
    background: var(--gradient-hero);
    color: white;
    padding: var(--space-10) var(--space-8);
    border-radius: var(--radius-xl);
    margin-bottom: var(--space-8);
    box-shadow: 0 12px 32px rgba(2, 132, 199, 0.25);
  }

  .hero-badges {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .hero-badges .badge {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    backdrop-filter: blur(8px);
    border: none;
  }

  .hero-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: white;
    margin-bottom: var(--space-4);
    line-height: 1.2;
  }

  .hero-description {
    font-size: var(--text-md);
    color: rgba(255, 255, 255, 0.9);
    max-width: 820px;
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .hero-ref {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.8);
    background: rgba(0, 0, 0, 0.2);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .pearls-banner {
    margin-bottom: var(--space-8);
  }

  .article-layout-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-10);
    align-items: start;
  }

  .article-content-wrapper {
    min-width: 0;
  }

  .article-sidebar {
    position: sticky;
    top: 84px;
  }

  .toc-sticky-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
  }

  .toc-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-4);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-link {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: all var(--tr-fast);
  }

  .toc-link:hover {
    background-color: var(--color-primary-hl);
    color: var(--color-primary);
  }

  .toc-idx {
    font-size: 0.8em;
    font-weight: 700;
    color: var(--color-primary);
    opacity: 0.7;
  }

  @media (max-width: 980px) {
    .article-layout-grid {
      grid-template-columns: 1fr;
    }
    .article-sidebar {
      display: none;
    }
  }
</style>
