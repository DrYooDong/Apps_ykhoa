---
export interface LoopNode {
  label: string;
  detail?: string;
  type?: 'stimulus' | 'receptor' | 'control' | 'effector' | 'response';
}

export interface Props {
  title: string;
  type?: 'negative' | 'positive';
  nodes?: LoopNode[];
}

const { title, type = 'negative', nodes = [] } = Astro.props;
---

<div class:list={['feedback-loop-card', `loop-${type}`]}>
  <div class="loop-header">
    <i class:list={['fas', type === 'negative' ? 'fa-arrows-rotate' : 'fa-bolt']}></i>
    <h4>{title} ({type === 'negative' ? 'Phản Hồi Âm Tính' : 'Phản Hồi Dương Tính'})</h4>
  </div>

  {nodes.length > 0 && (
    <div class="loop-chain">
      {nodes.map((node, idx) => (
        <div class="loop-step">
          <div class:list={['node-bubble', `node-${node.type ?? 'stimulus'}`]}>
            <span class="node-idx">{idx + 1}</span>
            <div class="node-info">
              <strong>{node.label}</strong>
              {node.detail && <small>{node.detail}</small>}
            </div>
          </div>
          {idx < nodes.length - 1 && (
            <div class="node-arrow">
              <i class="fas fa-arrow-down"></i>
            </div>
          )}
        </div>
      ))}
    </div>
  )}
  <slot />
</div>

<style>
  .feedback-loop-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin: var(--space-6) 0;
    box-shadow: var(--shadow-sm);
  }

  .loop-negative {
    border-left: 4px solid var(--color-primary);
  }

  .loop-positive {
    border-left: 4px solid var(--clinical-critical);
  }

  .loop-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    color: var(--color-primary);
  }

  .loop-positive .loop-header {
    color: var(--clinical-critical);
  }

  .loop-chain {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .loop-step {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .node-bubble {
    width: 100%;
    max-width: 540px;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-surface-offset);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .node-idx {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .node-info {
    display: flex;
    flex-direction: column;
  }

  .node-info small {
    color: var(--color-text-muted);
  }

  .node-arrow {
    padding: var(--space-1) 0;
    color: var(--color-text-faint);
    font-size: var(--text-sm);
  }
</style>
