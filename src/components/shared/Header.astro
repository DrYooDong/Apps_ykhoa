---
import ThemeToggle from '../ui/ThemeToggle.astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Trang Chủ', icon: 'fa-house' },
  { href: '/sinh-ly/sl-tb-daicuong-tb', label: 'Sinh Lý', icon: 'fa-dna' },
  { href: '/sinh-ly-benh', label: 'Sinh Lý Bệnh', icon: 'fa-heart-pulse' },
  { href: '/hoa-sinh', label: 'Hóa Sinh', icon: 'fa-atom' },
  { href: '/dich-te-hoc/dth-dengue', label: 'Dịch Tễ', icon: 'fa-virus' },
  { href: '/ebm/kho-guidelines', label: 'EBM Guidelines', icon: 'fa-book-medical' },
  { href: '/cong-cu', label: 'Công Cụ CDSS', icon: 'fa-calculator' }
];
---

<header class="app-header">
  <div class="header-inner">
    <div class="header-brand">
      <a href="/" class="brand-link">
        <div class="brand-logo">
          <i class="fas fa-heart-pulse"></i>
        </div>
        <div class="brand-text">
          <span class="brand-title">CliniPortal</span>
          <span class="brand-subtitle">Clinical Ecosystem</span>
        </div>
      </a>
    </div>

    <nav class="header-nav">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class:list={['nav-link', { 'active': currentPath.startsWith(link.href) && link.href !== '/' || currentPath === link.href }]}
        >
          <i class:list={['fas', link.icon]}></i>
          <span>{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Mở menu điều hướng">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </div>
</header>

<style>
  .app-header {
    height: var(--header-height);
    background-color: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: var(--content-wide-width);
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-brand .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
  }

  .brand-logo {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--gradient-hero);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-md);
    box-shadow: 0 2px 8px rgba(2, 132, 199, 0.3);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-md);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .brand-subtitle {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    transition: all var(--tr-fast);
    white-space: nowrap;
  }

  .nav-link:hover {
    background-color: var(--color-primary-hl);
    color: var(--color-primary);
  }

  .nav-link.active {
    background-color: var(--color-primary-hl);
    color: var(--color-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .mobile-menu-btn {
    display: none;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background-color: var(--color-surface-offset);
    border: 1px solid var(--color-border);
  }

  @media (max-width: 1040px) {
    .header-nav {
      display: none;
    }
    .mobile-menu-btn {
      display: inline-flex;
    }
  }
</style>
