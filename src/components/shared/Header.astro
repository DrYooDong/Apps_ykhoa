---
import ThemeToggle from '../ui/ThemeToggle.astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Trang Chủ', icon: 'fa-house' },
  { href: '/sinh-ly/sl-tb-daicuong-tb', label: 'Sinh Lý', icon: 'fa-dna' },
  { href: '/sinh-ly-benh', label: 'Sinh Lý Bệnh', icon: 'fa-heart-pulse' },
  { href: '/hoa-sinh', label: 'Hóa Sinh', icon: 'fa-atom' },
  { href: '/dich-te-hoc/dth-dengue', label: 'Dịch Tễ', icon: 'fa-virus' },
  { href: '/ebm/kho-guidelines', label: 'EBM Guidelines', icon: 'fa-book-medical' },
  { href: '/cong-cu', label: 'Công Cụ CDSS', icon: 'fa-calculator' }
];
---

<header class="app-header">
  <div class="header-inner">
    <!-- TRÁI: Brand & Live Knowledge Stats -->
    <div class="header-brand">
      <a href="/" class="brand-link" title="Về Trang chủ CliniPortal">
        <div class="brand-logo">
          <i class="fa-solid fa-stethoscope"></i>
        </div>
        <div class="brand-text">
          <span class="brand-title">CliniPortal <span class="text-primary-accent">MedLens</span></span>
          <span class="brand-badge">CLINIPORTAL</span>
        </div>
      </a>

      <div class="live-knowledge-stats">
        <span class="live-dot-pulse"></span>
        <span>Tri thức:</span>
        <b>14</b> bệnh · <b>92</b> từ vựng · <span class="stat-blue">2.400+</span> bài · <span class="stat-rose">78</span> Guidelines
      </div>
    </div>

    <!-- GIỮA: 4 Shortcuts + Navigation Bridges -->
    <div class="header-center">
      <div class="clinical-shortcuts-strip">
        <a href="/ebm/kho-guidelines" class="shortcut-chip chip-guidelines" title="Kho Guidelines EBM">
          <span>📚</span><span>Guidelines</span>
        </a>
        <a href="/cong-cu" class="shortcut-chip chip-tools" title="Kho Công cụ & Thang điểm CDSS">
          <span>🧮</span><span>Công cụ</span>
        </a>
        <a href="/#/docspace" class="shortcut-chip chip-icd" title="Kho ICD-10">
          <span>🏷️</span><span>ICD-10</span>
        </a>
        <a href="/#/docspace" class="shortcut-chip chip-cdss" title="Kho CDSS">
          <span>⚡</span><span>CDSS</span>
        </a>
      </div>

      <div class="header-v-divider"></div>

      <nav class="header-nav-bridges">
        <a href="/#/vault" class="nav-bridge-btn bridge-vault" title="Kho Tri thức Knowledge Vault">
          <i class="fa-solid fa-book-open"></i>
          <span>Kho tri thức</span>
        </a>
        <a href="/#/docspace" class="nav-bridge-btn bridge-cases" title="DocSpace & Kho ca lâm sàng">
          <i class="fa-solid fa-notes-medical"></i>
          <span>Kho ca lâm sàng</span>
          <span class="bridge-pulse-dot"></span>
        </a>
        <a href="/sinh-ly/sl-tb-daicuong-tb" class="nav-bridge-btn bridge-basic" title="Cơ sở Y khoa">
          <i class="fa-solid fa-dna"></i>
          <span>Cơ sở</span>
        </a>
      </nav>
    </div>

    <!-- PHẢI: Actions, Doctor User Profile & Theme -->
    <div class="header-actions">
      <ThemeToggle />

      <a href="/#/docspace" class="doctor-profile-badge" title="Thông tin Bác sĩ Lâm sàng">
        <div class="doctor-avatar">Đ</div>
        <div class="doctor-meta">
          <span class="doctor-name">BS.CKII Nguyễn Văn ...</span>
          <span class="doctor-sub">Tim mạch & Cấp cứu</span>
        </div>
      </a>

      <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Mở menu điều hướng">
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
  </div>
</header>

<style>
  .app-header {
    height: 56px;
    background-color: var(--glass-bg, rgba(255, 255, 255, 0.95));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border, #e2e8f0);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  [data-theme="dark"] .app-header {
    background-color: rgba(15, 23, 42, 0.95);
    border-bottom-color: var(--color-border, #334155);
  }

  .header-inner {
    width: 100%;
    height: 100%;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    box-sizing: border-box;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: 0 0 auto;
  }

  .header-brand .brand-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .brand-logo {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    background: var(--color-primary, #0284c7);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    box-shadow: 0 1px 3px rgba(2, 132, 199, 0.25);
  }

  .brand-text {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .brand-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.025em;
    color: var(--color-text, #0f172a);
  }

  .text-primary-accent {
    color: var(--color-primary, #0284c7);
  }

  .brand-badge {
    display: none;
    padding: 0.12rem 0.45rem;
    background: rgba(2, 132, 199, 0.08);
    border: 1px solid rgba(2, 132, 199, 0.25);
    border-radius: 4px;
    font-size: 9.5px;
    font-weight: 800;
    color: var(--color-primary, #0284c7);
    text-transform: uppercase;
  }
  @media (min-width: 640px) {
    .brand-badge {
      display: inline-flex;
    }
  }

  /* Live Stats */
  .live-knowledge-stats {
    display: none;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    color: var(--color-text-muted, #64748b);
    background: var(--color-surface-offset, #f8fafc);
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid var(--color-border, #e2e8f0);
    margin-left: 0.25rem;
    white-space: nowrap;
  }
  @media (min-width: 1440px) {
    .live-knowledge-stats {
      display: inline-flex;
    }
  }

  .live-dot-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary, #0284c7);
    box-shadow: 0 0 6px var(--color-primary, #0284c7);
    animation: live-pulse 2s infinite ease-in-out;
  }

  @keyframes live-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.8); }
  }

  .stat-blue { color: var(--color-primary, #0284c7); font-weight: 700; }
  .stat-rose { color: #e11d48; font-weight: 700; }

  /* Center */
  .header-center {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: 1 1 auto;
    justify-content: center;
    min-width: 0;
  }

  .clinical-shortcuts-strip {
    display: none;
    align-items: center;
    gap: 0.35rem;
    background: var(--color-surface-offset, #f1f5f9);
    padding: 0.2rem 0.35rem;
    border-radius: 8px;
    border: 1px solid var(--color-border, #e2e8f0);
  }
  @media (min-width: 1080px) {
    .clinical-shortcuts-strip {
      display: inline-flex;
    }
  }

  .shortcut-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.22rem 0.55rem;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .shortcut-chip.chip-guidelines { color: #881337; background: #fff1f2; }
  .shortcut-chip.chip-tools { color: #78350f; background: #fffbeb; }
  .shortcut-chip.chip-icd { color: #0c4a6e; background: #f0f9ff; }
  .shortcut-chip.chip-cdss { color: #581c87; background: #faf5ff; }

  .header-v-divider {
    width: 1px;
    height: 16px;
    background: var(--color-border, #cbd5e1);
    display: none;
  }
  @media (min-width: 1080px) {
    .header-v-divider {
      display: block;
    }
  }

  .header-nav-bridges {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-bridge-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.28rem 0.7rem;
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .nav-bridge-btn.bridge-vault { background: #eef2ff; color: #4338ca; }
  .nav-bridge-btn.bridge-cases { background: #eff6ff; color: #1d4ed8; }
  .nav-bridge-btn.bridge-basic { background: var(--color-surface-offset, #f8fafc); color: var(--color-text, #0f172a); }

  .bridge-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    animation: live-pulse 1.8s infinite ease-in-out;
  }

  /* Right & Doctor Profile */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 0 0 auto;
  }

  .doctor-profile-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem 0.2rem 0.3rem;
    background: var(--color-surface-offset, #f8fafc);
    border: 1px solid var(--color-border, #cbd5e1);
    border-radius: 7px;
    text-decoration: none;
  }

  .doctor-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-primary, #0284c7);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 11px;
  }

  .doctor-meta {
    display: none;
    flex-direction: column;
    line-height: 1.15;
    text-align: left;
  }
  @media (min-width: 1280px) {
    .doctor-meta {
      display: flex;
    }
  }

  .doctor-name {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-text, #0f172a);
    max-width: 130px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .doctor-sub {
    font-size: 9.5px;
    color: var(--color-text-muted, #64748b);
    max-width: 130px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mobile-menu-btn {
    display: none;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background-color: var(--color-surface-offset);
    border: 1px solid var(--color-border);
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .header-center {
      display: none;
    }
    .mobile-menu-btn {
      display: inline-flex;
    }
  }
</style>
