---
const currentYear = new Date().getFullYear();
---

<footer class="app-footer" id="astroSiteFooter">
  <div class="footer-inner">
    <div class="footer-grid">
      <!-- Cột 1: Thương hiệu & Trạng thái Offline -->
      <div class="footer-brand-col">
        <a href="/" class="brand-badge" title="Về Trang chủ CliniPortal">
          <span class="brand-badge-box"><i class="fa-solid fa-stethoscope"></i></span>
          <span>CliniPortal <span class="text-primary-accent">MedLens</span></span>
        </a>
        <p class="brand-desc">
          Hệ sinh thái hỗ trợ quyết định lâm sàng, y học chứng cứ và bài giảng khoa học y cơ sở chuẩn xác dành cho bác sĩ nội khoa &amp; trực cấp cứu.
        </p>
        <div class="footer-status-pill">
          <span class="footer-status-dot" aria-hidden="true"></span>
          <span>Offline-First MDX · EBM 2026</span>
        </div>
      </div>

      <!-- Cột 2: Phân hệ Nội dung (Accordion trên Mobile) -->
      <div class="footer-links-col is-accordion" data-astro-footer-accordion>
        <button type="button" class="footer-accordion-btn" aria-expanded="false">
          <span>5 Phân Hệ Nội Dung</span>
          <i class="fa-solid fa-chevron-down footer-acc-chevron" aria-hidden="true"></i>
        </button>
        <ul class="footer-acc-list">
          <li><a href="/sinh-ly"><i class="fa-solid fa-dna"></i> Sinh lý học Y khoa</a></li>
          <li><a href="/sinh-ly-benh"><i class="fa-solid fa-heart-pulse"></i> Sinh lý bệnh (CCBS)</a></li>
          <li><a href="/hoa-sinh"><i class="fa-solid fa-atom"></i> Hóa sinh Y học</a></li>
          <li><a href="/dich-te-hoc"><i class="fa-solid fa-virus"></i> Dịch tễ học lâm sàng</a></li>
          <li><a href="/clinical-handbook"><i class="fa-solid fa-book-medical"></i> Sổ tay Đúc kết Lâm sàng</a></li>
        </ul>
      </div>

      <!-- Cột 3: Công cụ & Tiêu chuẩn EBM (Accordion trên Mobile) -->
      <div class="footer-links-col is-accordion" data-astro-footer-accordion>
        <button type="button" class="footer-accordion-btn" aria-expanded="false">
          <span>Công Cụ &amp; EBM</span>
          <i class="fa-solid fa-chevron-down footer-acc-chevron" aria-hidden="true"></i>
        </button>
        <ul class="footer-acc-list">
          <li><a href="/ebm/kho-guidelines"><i class="fa-solid fa-scale-balanced"></i> Kho Guidelines 2026</a></li>
          <li><a href="/ebm/kho-nghien-cuu"><i class="fa-solid fa-microscope"></i> Kho Phân Tích Nghiên Cứu</a></li>
          <li><a href="/cong-cu"><i class="fa-solid fa-calculator"></i> Công cụ &amp; Lưu đồ CDSS</a></li>
          <li><a href="https://dryoodong.github.io/CDSS_Standalone/?theme=light" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-microchip"></i> CDSS Platform Suite</a></li>
          <li><a href="https://pubmed.ncbi.nlm.nih.gov" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-book-open"></i> PubMed / Medline</a></li>
          <li><a href="https://www.escardio.org" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-globe"></i> ESC / KDIGO Guidelines</a></li>
        </ul>
      </div>

      <!-- Cột 4: An toàn Lâm sàng -->
      <div class="footer-safety-col">
        <h5>Chuẩn Mực &amp; An Toàn Y Khoa</h5>
        <div class="footer-disclaimer-card">
          <div class="disclaimer-title">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>Miễn trừ trách nhiệm y khoa</span>
          </div>
          <p>
            Nội dung phục vụ tham khảo chuyên môn theo Bộ Y tế, ESC, KDIGO, IDSA. Không thay thế phán xét lâm sàng trực tiếp của bác sĩ điều trị.
          </p>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} <strong>CliniPortal MedLens</strong> · Hệ sinh thái Y khoa Offline-first</p>
      <div class="footer-tags">
        <span class="badge badge-primary"><i class="fa-solid fa-shield-heart"></i> EBM Verified</span>
        <span class="badge"><i class="fa-solid fa-mobile-screen-button"></i> Adaptive Shell</span>
        <span class="badge"><i class="fa-solid fa-universal-access"></i> WCAG AA</span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-astro-footer-accordion]').forEach((col) => {
      const btn = col.querySelector('.footer-accordion-btn');
      if (!btn) return;
      btn.addEventListener('click', () => {
        if (window.innerWidth > 767) return;
        const isOpen = col.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
  });
</script>

<style>
  .app-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-12);
    padding: var(--space-10) 0 var(--space-6);
    position: relative;
  }

  .app-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(var(--color-primary-rgb, 8, 127, 156), 0.5),
      transparent
    );
  }

  .footer-inner {
    max-width: var(--content-wide-width, 1440px);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1.25fr;
    gap: 2rem;
    margin-bottom: var(--space-8);
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 800;
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: 0.65rem;
  }

  .brand-badge-box {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--color-primary);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
  }

  .text-primary-accent {
    color: var(--color-primary);
  }

  .brand-desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-width: 380px;
    line-height: 1.55;
    margin-bottom: 0.75rem;
  }

  .footer-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.28rem 0.65rem;
    border-radius: 9999px;
    background: var(--color-success-hl, #ecfdf5);
    border: 1px solid rgba(var(--color-success-rgb, 5, 150, 105), 0.25);
    color: var(--color-success, #059669);
    font-size: 0.74rem;
    font-weight: 700;
  }

  .footer-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success, #059669);
  }

  .footer-accordion-btn,
  .footer-safety-col h5 {
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 0.75rem;
    color: var(--color-text);
  }

  .footer-accordion-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    padding: 0;
    cursor: default;
    text-align: left;
  }

  .footer-acc-chevron {
    display: none;
    transition: transform 0.2s ease;
  }

  .footer-acc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .footer-acc-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--tr-fast), transform var(--tr-fast);
  }

  .footer-acc-list a i {
    width: 15px;
    text-align: center;
    color: var(--color-primary);
    font-size: 0.82rem;
  }

  .footer-acc-list a:hover {
    color: var(--color-primary);
    transform: translateX(2px);
  }

  .footer-disclaimer-card {
    padding: 0.85rem;
    border-radius: 10px;
    background: var(--color-warning-hl, #fffbeb);
    border: 1px solid rgba(var(--color-warning-rgb, 217, 119, 6), 0.28);
    border-left: 3px solid var(--color-warning, #d97706);
  }

  .disclaimer-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-warning, #b45309);
    margin-bottom: 0.3rem;
  }

  .footer-disclaimer-card p {
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-divider);
    padding-top: var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .footer-tags .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--color-surface-offset);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .footer-tags .badge-primary {
    background: var(--color-primary-hl);
    border-color: rgba(var(--color-primary-rgb, 8, 127, 156), 0.22);
    color: var(--color-primary);
  }

  /* Tablet: 2x2 */
  @media (max-width: 1023px) and (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 2rem;
    }
  }

  /* Mobile: Compact Accordion + Bottom Nav Safe Zone */
  @media (max-width: 767px) {
    .app-footer {
      padding: 1.5rem 0 calc(68px + env(safe-area-inset-bottom, 0px) + 1rem);
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 0.8rem;
      margin-bottom: 1.25rem;
    }

    .footer-links-col.is-accordion {
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background: var(--color-surface-2, #f8fafc);
      padding: 0.1rem 0.85rem;
    }

    .footer-accordion-btn {
      min-height: 44px;
      margin: 0;
      cursor: pointer;
    }

    .footer-acc-chevron {
      display: inline-block;
    }

    .footer-links-col.is-open .footer-acc-chevron {
      transform: rotate(180deg);
    }

    .footer-links-col .footer-acc-list {
      display: none;
      padding: 0.55rem 0 0.75rem;
      border-top: 1px solid var(--color-divider);
      grid-template-columns: repeat(2, 1fr);
      gap: 0.4rem 0.65rem;
    }

    .footer-links-col.is-open .footer-acc-list {
      display: grid;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
      justify-content: center;
    }
  }

  @media (max-width: 420px) {
    .footer-links-col.is-open .footer-acc-list {
      grid-template-columns: 1fr;
    }
  }
</style>
