{
  "name": "cliniportal",
  "version": "2.0.0",
  "description": "CliniPortal — Hệ sinh thái Web & App Y khoa Offline Đa nền tảng",
  "main": "platforms/desktop/main-electron.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/scripts/copy-dist.js",
    "preview": "vite preview",
    "vite:dev": "vite",
    "vite:build": "tsc --noEmit && vite build && node tools/scripts/copy-dist.js",
    "astro:dev": "astro dev",
    "astro:build": "astro build",
    "astro:preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && git subtree push --prefix dist origin gh-pages",
    "start": "electron platforms/desktop/main-electron.js",
    "desktop": "electron platforms/desktop/main-electron.js",
    "migrate": "node -e \"require('esbuild').buildSync({entryPoints:['tools/scripts/ume-migrate.ts'],outfile:'tools/scripts/ume-migrate.cjs',bundle:true,platform:'node'}); require('./tools/scripts/ume-migrate.cjs'); require('fs').unlinkSync('tools/scripts/ume-migrate.cjs');\"",
    "migrate:validate": "tsc --noEmit",
    "lint:content": "node tools/scripts/medical-linter.mjs",
    "audit:deadcode": "node tools/scripts/tree-shake-audit.mjs",
    "validate:all": "npm run typecheck && npm run lint:content && npm run audit:deadcode"
  },
  "keywords": [
    "medical",
    "cliniportal",
    "calculators",
    "guidelines",
    "ebm",
    "offline-first",
    "electron",
    "pwa"
  ],
  "author": "CliniPortal Team",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "astro": "^7.2.7",
    "rehype-katex": "^7.0.1",
    "remark-heading-id": "^1.0.1",
    "remark-math": "^6.0.0"
  }
}
