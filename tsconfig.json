{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "verbatimModuleSyntax": false,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@styles/*": ["./src/styles/*"],
      "@content/*": ["./src/content/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "**/*.astro"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/node_modules/**",
    "src/content/docspace",
    "src/content/knowledge-vault/cdss/ecg",
    "src/content/knowledge-vault/cdss/ecg/**",
    "src/content/knowledge-vault/cdss/abg",
    "src/content/knowledge-vault/cdss/abg/**",
    "src/content/knowledge-vault/cdss/microbio",
    "src/content/knowledge-vault/cdss/microbio/**",
    "src/content/knowledge-vault/cdss/dengue",
    "src/content/knowledge-vault/cdss/dengue/**",
    "src/**/tools/**",
    "tools/**",
    "src/content.config.ts",
    "src/data/search-index-bundle.js",
    "src/data/quick-search-index.js",
    "**/*-bundle.js",
    "**/*.bundle.js",
    "**/assets/*.js"
  ]
}