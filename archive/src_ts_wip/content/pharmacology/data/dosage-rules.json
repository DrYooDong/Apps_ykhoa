{
  "version": "1.0.0",
  "formulas": {
    "cockcroftGault": {
      "name": "Cockcroft-Gault CrCl Formula",
      "expression": "CrCl (mL/min) = [ (140 - Age) * Weight_kg ] / (72 * Serum_Cr_mg_dL) * (0.85 if Female)",
      "variables": ["age", "weight", "gender", "scr"]
    },
    "idealBodyWeight": {
      "name": "Devine IBW Formula",
      "male": "50 + 2.3 * (Height_inches - 60)",
      "female": "45.5 + 2.3 * (Height_inches - 60)"
    }
  },
  "crclBrackets": [
    { "code": "NORMAL", "minCrCl": 90, "maxCrCl": 999, "label": "Chức năng thận bình thường (CrCl >= 90 mL/min)", "severityClass": "success" },
    { "code": "MILD", "minCrCl": 60, "maxCrCl": 89, "label": "Suy thận nhẹ (CrCl 60-89 mL/min)", "severityClass": "info" },
    { "code": "MODERATE", "minCrCl": 30, "maxCrCl": 59, "label": "Suy thận trung bình (CrCl 30-59 mL/min)", "severityClass": "warning" },
    { "code": "SEVERE", "minCrCl": 15, "maxCrCl": 29, "label": "Suy thận nặng (CrCl 15-29 mL/min)", "severityClass": "danger" },
    { "code": "ESRD", "minCrCl": 0, "maxCrCl": 14, "label": "Suy thận giai đoạn cuối / Lọc máu (CrCl < 15 mL/min)", "severityClass": "danger" }
  ]
}
